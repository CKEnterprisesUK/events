APP_NAME="Event Ticketing Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://events.domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Single shared MySQL database (tenant isolation by company_id)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=events
DB_USERNAME=root
DB_PASSWORD=
# On shared/XAMPP hosting a unix socket may be required; leave blank for TCP.
DB_SOCKET=

# Separate MySQL database used by the test suite so SELECT ... FOR UPDATE is real.
DB_TEST_DATABASE=events_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Background work runs on the database queue, drained by cron (no persistent worker).
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# cPanel SMTP by default; TicketMailer binding can be swapped later.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@events.domain"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Connect (Standard) + Checkout. Keys live outside the web root in .env.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Stable across deploys so previously issued QR tokens keep verifying.
QR_HMAC_SECRET=

# Address geocoding for in-person event locations (OpenStreetMap Nominatim).
# A genuine, identifying User-Agent is REQUIRED by Nominatim's usage policy;
# without it the geocoder refuses to call out and event coordinates never set.
# Use your own contact, e.g. "EventTicketing/1.0 (ops@example.com)".
NOMINATIM_USER_AGENT=

VITE_APP_NAME="${APP_NAME}"
